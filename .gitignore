# Entorno Virtual de Python
# No subir esta carpeta, es específica de cada computadora
venv/
*.pyc

# Archivos de caché de Python
__pycache__/
.pytest_cache/

# Base de datos
# NUNCA subas el archivo de la base de datos a un repositorio público
database.db
database.backup-*.db

# Clave secreta generada automáticamente en el primer arranque
.secret_key

# Archivos de Excel con datos de usuarios
# Estos archivos contienen información sensible
*.xlsx
# Backups automáticos de la base (ver backup_db.py)
backups/
